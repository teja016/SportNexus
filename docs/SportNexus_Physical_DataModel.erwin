        <Object class="Index Member" id="IDXM100301"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1011"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: transit_passengers
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E011" name="Transit Passengers">
      <Props>
        <P n="Physical_Name">transit_passengers</P>
        <P n="Schema">public</P>
        <P n="Comment">Per-student record within a transit session. stop_order set by nearest-neighbor TSP algorithm at session creation. Cascade-deleted when session is removed.</P>
      </Props>

      <Object class="Attribute" id="A1101" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A1102" name="session_id">
        <Props><P n="Physical_Name">session_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → transit_sessions.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A1103" name="enrollment_id">
        <Props><P n="Physical_Name">enrollment_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → enrollments.id  UNIQUE (one passenger record per enrollment per session)</P></Props>
      </Object>
      <Object class="Attribute" id="A1104" name="stop_order">
        <Props><P n="Physical_Name">stop_order</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Comment">Pickup sequence number (1 = first stop). Determined by TSP algorithm using pickup_lat/lng.</P></Props>
      </Object>
      <Object class="Attribute" id="A1105" name="status">
        <Props><P n="Physical_Name">status</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'WAITING'</P><P n="Domain_Ref">D005</P></Props>
      </Object>
      <Object class="Attribute" id="A1106" name="picked_up_at">
        <Props><P n="Physical_Name">picked_up_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NULL</P><P n="Comment">Timestamp when driver marked student as PICKED_UP</P></Props>
      </Object>
      <Object class="Attribute" id="A1107" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>

      <Object class="Key Group" id="KG1101" name="PK_transit_passengers">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_transit_passengers</P></Props>
        <Object class="Key Group Member" id="KGM110101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1101"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG1102" name="UQ_transit_passengers_enrollment_id">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_transit_passengers_enrollment_id</P></Props>
        <Object class="Key Group Member" id="KGM110201"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1103"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX1101" name="IDX_transit_passengers_session_id">
        <Props><P n="Physical_Name">IDX_transit_passengers_session_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM110101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1102"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX1102" name="IDX_transit_passengers_enrollment_id">
        <Props><P n="Physical_Name">IDX_transit_passengers_enrollment_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM110201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1103"/></Props></Object>
      </Object>
    </Object>

