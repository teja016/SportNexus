    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: transit_sessions
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E010" name="Transit Sessions">
      <Props>
        <P n="Physical_Name">transit_sessions</P>
        <P n="Schema">public</P>
        <P n="Comment">One record per slot per day. Created by BullMQ daily cron at 23:30 UTC for the next day. Driver location updated in real-time via Socket.IO room transit:{id}.</P>
      </Props>

      <Object class="Attribute" id="A1001" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A1002" name="slot_id">
        <Props><P n="Physical_Name">slot_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → slots.id</P></Props>
      </Object>
      <Object class="Attribute" id="A1003" name="date">
        <Props><P n="Physical_Name">date</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Comment">Date of the session (truncated to day). UNIQUE with slot_id.</P></Props>
      </Object>
      <Object class="Attribute" id="A1004" name="status">
        <Props><P n="Physical_Name">status</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'SCHEDULED'</P><P n="Domain_Ref">D004</P></Props>
      </Object>
      <Object class="Attribute" id="A1005" name="driver_lat">
        <Props><P n="Physical_Name">driver_lat</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NULL</P><P n="Comment">Live driver latitude — updated every ~5s by driver app via Socket.IO</P></Props>
      </Object>
      <Object class="Attribute" id="A1006" name="driver_lng">
        <Props><P n="Physical_Name">driver_lng</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A1007" name="eta_minutes">
        <Props><P n="Physical_Name">eta_minutes</P><P n="Datatype">INTEGER</P><P n="Null_Option">NULL</P><P n="Comment">ETA to next passenger stop in minutes</P></Props>
      </Object>
      <Object class="Attribute" id="A1008" name="driver_name">
        <Props><P n="Physical_Name">driver_name</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NULL</P><P n="Comment">Snapshot from transport_routes at session creation</P></Props>
      </Object>
      <Object class="Attribute" id="A1009" name="driver_phone">
        <Props><P n="Physical_Name">driver_phone</P><P n="Datatype">VARCHAR(20)</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A1010" name="vehicle_number">
        <Props><P n="Physical_Name">vehicle_number</P><P n="Datatype">VARCHAR(20)</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A1011" name="driver_user_id">
        <Props><P n="Physical_Name">driver_user_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NULL</P><P n="Comment">FK → users.id  (optional — driver with user account for Socket.IO auth)</P></Props>
      </Object>
      <Object class="Attribute" id="A1012" name="cancelled_at">
        <Props><P n="Physical_Name">cancelled_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A1013" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>
      <Object class="Attribute" id="A1014" name="updated_at">
        <Props><P n="Physical_Name">updated_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG1001" name="PK_transit_sessions">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_transit_sessions</P></Props>
        <Object class="Key Group Member" id="KGM100101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1001"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG1002" name="UQ_transit_sessions_slot_date">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_transit_sessions_slot_date</P><P n="Comment">Prevents duplicate sessions for same slot+day</P></Props>
        <Object class="Key Group Member" id="KGM100201"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1002"/></Props></Object>
        <Object class="Key Group Member" id="KGM100202"><Props><P n="Sequence">1</P><P n="Key_Group_Member_Column" ref="A1003"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX1001" name="IDX_transit_sessions_slot_id">
        <Props><P n="Physical_Name">IDX_transit_sessions_slot_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM100101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1002"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX1002" name="IDX_transit_sessions_date">
        <Props><P n="Physical_Name">IDX_transit_sessions_date</P><P n="Index_Type">Non-Unique</P><P n="Comment">Used by daily cron and GET /transit/today</P></Props>
        <Object class="Index Member" id="IDXM100201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1003"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX1003" name="IDX_transit_sessions_driver_user_id">
