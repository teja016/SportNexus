    <Object class="Entity" id="E012" name="Reviews">
      <Props>
        <P n="Physical_Name">reviews</P>
        <P n="Schema">public</P>
        <P n="Comment">Academy reviews submitted by users. One review per user per academy (unique constraint). rating triggers recalculation of academies.rating + reviewCount.</P>
      </Props>

      <Object class="Attribute" id="A1201" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A1202" name="user_id">
        <Props><P n="Physical_Name">user_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → users.id</P></Props>
      </Object>
      <Object class="Attribute" id="A1203" name="academy_id">
        <Props><P n="Physical_Name">academy_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → academies.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A1204" name="rating">
        <Props><P n="Physical_Name">rating</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Comment">Star rating 1–5. CHECK(rating &gt;= 1 AND rating &lt;= 5)</P></Props>
      </Object>
      <Object class="Attribute" id="A1205" name="comment">
        <Props><P n="Physical_Name">comment</P><P n="Datatype">TEXT</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A1206" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>
      <Object class="Attribute" id="A1207" name="updated_at">
        <Props><P n="Physical_Name">updated_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG1201" name="PK_reviews">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_reviews</P></Props>
        <Object class="Key Group Member" id="KGM120101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1201"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG1202" name="UQ_reviews_user_academy">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_reviews_user_academy</P><P n="Comment">One review per user per academy</P></Props>
        <Object class="Key Group Member" id="KGM120201"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A1202"/></Props></Object>
        <Object class="Key Group Member" id="KGM120202"><Props><P n="Sequence">1</P><P n="Key_Group_Member_Column" ref="A1203"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX1201" name="IDX_reviews_academy_id">
        <Props><P n="Physical_Name">IDX_reviews_academy_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM120101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A1203"/></Props></Object>
