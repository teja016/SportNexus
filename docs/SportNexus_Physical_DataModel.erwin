<?xml version="1.0" encoding="UTF-8"?>
<erwin:r9 xmlns:erwin="http://erwin.com/erwin/r9/r9"
  erwin:buildId="9.65.0.2231"
  erwin:version="9.65"
  erwin:date="2026-04-22"
  erwin:application="ERwin Data Modeler">

  <Object class="Model" id="M001" name="SportNexus Physical Data Model">
    <Props>
      <P n="Type">Physical</P>
      <P n="Target_Server">PostgreSQL</P>
      <P n="Target_Server_Version">16</P>
      <P n="Schema">public</P>
      <P n="Author">SportNexus Team</P>
      <P n="Description">Physical data model for SportNexus sports academy booking platform. PostgreSQL 16, managed via Prisma ORM.</P>
      <P n="Created">2026-04-22</P>
    </Props>

    <!-- ═══════════════════════════════════════════════════════════
         DOMAINS  (PostgreSQL CHECK-constrained enum types)
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Domain" id="D001" name="UserRole">
      <Props>
        <P n="Physical_Name">user_role</P>
        <P n="Datatype">VARCHAR(50)</P>
        <P n="Null_Option">NOT NULL</P>
        <P n="Default_Value">'USER'</P>
        <P n="Validation_Rule">CHECK (VALUE IN ('USER','ACADEMY_ADMIN','SUPER_ADMIN','TRANSPORT_OPERATOR','DRIVER'))</P>
        <P n="Comment">Roles: USER=app user, ACADEMY_ADMIN=academy owner, SUPER_ADMIN=platform admin, TRANSPORT_OPERATOR=route manager, DRIVER=vehicle driver</P>
      </Props>
    </Object>

    <Object class="Domain" id="D002" name="EnrollmentStatus">
      <Props>
        <P n="Physical_Name">enrollment_status</P>
        <P n="Datatype">VARCHAR(50)</P>
        <P n="Null_Option">NOT NULL</P>
        <P n="Default_Value">'PENDING'</P>
        <P n="Validation_Rule">CHECK (VALUE IN ('PENDING','CONFIRMED','ACTIVE','CANCELLED','EXPIRED'))</P>
        <P n="Comment">Lifecycle: PENDING→payment pending, CONFIRMED→paid, ACTIVE→attending, CANCELLED→user/admin cancelled, EXPIRED→duration elapsed</P>
      </Props>
    </Object>

    <Object class="Domain" id="D003" name="PaymentStatus">
      <Props>
        <P n="Physical_Name">payment_status</P>
        <P n="Datatype">VARCHAR(50)</P>
        <P n="Null_Option">NOT NULL</P>
        <P n="Default_Value">'PENDING'</P>
        <P n="Validation_Rule">CHECK (VALUE IN ('PENDING','SUCCESS','FAILED','REFUNDED'))</P>
        <P n="Comment">Razorpay payment lifecycle states</P>
      </Props>
    </Object>

    <Object class="Domain" id="D004" name="TransitStatus">
      <Props>
        <P n="Physical_Name">transit_status</P>
        <P n="Datatype">VARCHAR(50)</P>
        <P n="Null_Option">NOT NULL</P>
        <P n="Default_Value">'SCHEDULED'</P>
        <P n="Validation_Rule">CHECK (VALUE IN ('SCHEDULED','DISPATCHED','ARRIVING','PICKED_UP','AT_ACADEMY','COMPLETED','CANCELLED_BY_USER'))</P>
        <P n="Comment">Daily transit session lifecycle — driven by driver app events via Socket.IO</P>
      </Props>
    </Object>

    <Object class="Domain" id="D005" name="PassengerStatus">
      <Props>
        <P n="Physical_Name">passenger_status</P>
        <P n="Datatype">VARCHAR(50)</P>
        <P n="Null_Option">NOT NULL</P>
        <P n="Default_Value">'WAITING'</P>
        <P n="Validation_Rule">CHECK (VALUE IN ('WAITING','PICKED_UP','ABSENT'))</P>
        <P n="Comment">Per-student status within a transit session</P>
      </Props>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: users
         Stores all platform users regardless of role.
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E001" name="Users">
      <Props>
        <P n="Physical_Name">users</P>
        <P n="Schema">public</P>
        <P n="Comment">All registered users of the SportNexus platform. Role field differentiates access levels.</P>
      </Props>

      <Object class="Attribute" id="A0101" name="id">
        <Props>
          <P n="Physical_Name">id</P>
          <P n="Datatype">VARCHAR(30)</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Default_Value">cuid()</P>
          <P n="Comment">CUID primary key generated by Prisma</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0102" name="name">
        <Props>
          <P n="Physical_Name">name</P>
          <P n="Datatype">VARCHAR(255)</P>
          <P n="Null_Option">NOT NULL</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0103" name="email">
        <Props>
          <P n="Physical_Name">email</P>
          <P n="Datatype">VARCHAR(255)</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Comment">Unique — used for login</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0104" name="phone">
        <Props>
          <P n="Physical_Name">phone</P>
          <P n="Datatype">VARCHAR(20)</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Comment">Unique — E.164 format, used for OTP login</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0105" name="dob">
        <Props>
          <P n="Physical_Name">dob</P>
          <P n="Datatype">TIMESTAMPTZ</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Date of birth — optional, used for age-group matching</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0106" name="profile_photo">
        <Props>
          <P n="Physical_Name">profile_photo</P>
          <P n="Datatype">TEXT</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">URL or base64 of profile image</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0107" name="home_lat">
        <Props>
          <P n="Physical_Name">home_lat</P>
          <P n="Datatype">FLOAT8</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Home latitude — set during onboarding or location setup</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0108" name="home_lng">
        <Props>
          <P n="Physical_Name">home_lng</P>
          <P n="Datatype">FLOAT8</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Home longitude</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0109" name="home_address">
        <Props>
          <P n="Physical_Name">home_address</P>
          <P n="Datatype">TEXT</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Human-readable home address string</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0110" name="role">
        <Props>
          <P n="Physical_Name">role</P>
          <P n="Datatype">VARCHAR(50)</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Default_Value">'USER'</P>
          <P n="Domain_Ref">D001</P>
          <P n="Comment">See UserRole domain. Controls API access via RBAC guards.</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0111" name="firebase_uid">
        <Props>
          <P n="Physical_Name">firebase_uid</P>
          <P n="Datatype">VARCHAR(128)</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Unique Firebase Auth UID — null for phone-only users</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0112" name="refresh_token">
        <Props>
          <P n="Physical_Name">refresh_token</P>
          <P n="Datatype">TEXT</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">bcrypt-hashed JWT refresh token. Null after logout.</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0113" name="fcm_token">
        <Props>
          <P n="Physical_Name">fcm_token</P>
          <P n="Datatype">TEXT</P>
          <P n="Null_Option">NULL</P>
          <P n="Comment">Firebase Cloud Messaging device token for push notifications</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0114" name="created_at">
        <Props>
          <P n="Physical_Name">created_at</P>
          <P n="Datatype">TIMESTAMPTZ</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Default_Value">NOW()</P>
        </Props>
      </Object>
      <Object class="Attribute" id="A0115" name="updated_at">
        <Props>
          <P n="Physical_Name">updated_at</P>
          <P n="Datatype">TIMESTAMPTZ</P>
          <P n="Null_Option">NOT NULL</P>
          <P n="Comment">Auto-updated by Prisma @updatedAt</P>
        </Props>
      </Object>

      <!-- Key Groups -->
      <Object class="Key Group" id="KG0101" name="PK_users">
        <Props>
          <P n="Key_Group_Type">PrimaryKey</P>
          <P n="Physical_Name">PK_users</P>
        </Props>
        <Object class="Key Group Member" id="KGM010101">
          <Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0101"/></Props>
        </Object>
      </Object>
      <Object class="Key Group" id="KG0102" name="UQ_users_email">
        <Props>
          <P n="Key_Group_Type">Unique</P>
          <P n="Physical_Name">UQ_users_email</P>
        </Props>
        <Object class="Key Group Member" id="KGM010201">
          <Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0103"/></Props>
        </Object>
      </Object>
      <Object class="Key Group" id="KG0103" name="UQ_users_phone">
        <Props>
          <P n="Key_Group_Type">Unique</P>
          <P n="Physical_Name">UQ_users_phone</P>
        </Props>
        <Object class="Key Group Member" id="KGM010301">
          <Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0104"/></Props>
        </Object>
      </Object>
      <Object class="Key Group" id="KG0104" name="UQ_users_firebase_uid">
        <Props>
          <P n="Key_Group_Type">Unique</P>
          <P n="Physical_Name">UQ_users_firebase_uid</P>
        </Props>
        <Object class="Key Group Member" id="KGM010401">
          <Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0111"/></Props>
        </Object>
      </Object>

      <!-- Indexes -->
      <Object class="Index" id="IDX0101" name="IDX_users_email">
        <Props>
          <P n="Physical_Name">IDX_users_email</P>
          <P n="Index_Type">Non-Unique</P>
        </Props>
        <Object class="Index Member" id="IDXM010101">
          <Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0103"/></Props>
        </Object>
      </Object>
      <Object class="Index" id="IDX0102" name="IDX_users_phone">
        <Props>
          <P n="Physical_Name">IDX_users_phone</P>
          <P n="Index_Type">Non-Unique</P>
        </Props>
        <Object class="Index Member" id="IDXM010201">
          <Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0104"/></Props>
        </Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: academies
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E002" name="Academies">
      <Props>
        <P n="Physical_Name">academies</P>
        <P n="Schema">public</P>
        <P n="Comment">Sports academies listed on the platform. Geolocation used for distance-based discovery.</P>
      </Props>

      <Object class="Attribute" id="A0201" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0202" name="name">
        <Props><P n="Physical_Name">name</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0203" name="description">
        <Props><P n="Physical_Name">description</P><P n="Datatype">TEXT</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0204" name="address">
        <Props><P n="Physical_Name">address</P><P n="Datatype">TEXT</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0205" name="city">
        <Props><P n="Physical_Name">city</P><P n="Datatype">VARCHAR(100)</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0206" name="lat">
        <Props><P n="Physical_Name">lat</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Comment">Latitude — used in Haversine distance calculation</P></Props>
      </Object>
      <Object class="Attribute" id="A0207" name="lng">
        <Props><P n="Physical_Name">lng</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Comment">Longitude</P></Props>
      </Object>
      <Object class="Attribute" id="A0208" name="rating">
        <Props><P n="Physical_Name">rating</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">0</P><P n="Comment">Aggregate star rating (0.0–5.0), recalculated on each new review</P></Props>
      </Object>
      <Object class="Attribute" id="A0209" name="review_count">
        <Props><P n="Physical_Name">review_count</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">0</P></Props>
      </Object>
      <Object class="Attribute" id="A0210" name="transport_available">
        <Props><P n="Physical_Name">transport_available</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">FALSE</P><P n="Comment">Whether the academy offers pickup/drop transport service</P></Props>
      </Object>
      <Object class="Attribute" id="A0211" name="phone">
        <Props><P n="Physical_Name">phone</P><P n="Datatype">VARCHAR(20)</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0212" name="email">
        <Props><P n="Physical_Name">email</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0213" name="is_verified">
        <Props><P n="Physical_Name">is_verified</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">FALSE</P><P n="Comment">Set to TRUE by SUPER_ADMIN after vetting</P></Props>
      </Object>
      <Object class="Attribute" id="A0214" name="admin_user_id">
        <Props><P n="Physical_Name">admin_user_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NULL</P><P n="Comment">FK → users.id  Role=ACADEMY_ADMIN. NULL for super-admin-managed academies.</P></Props>
      </Object>
      <Object class="Attribute" id="A0215" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>
      <Object class="Attribute" id="A0216" name="updated_at">
        <Props><P n="Physical_Name">updated_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG0201" name="PK_academies">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_academies</P></Props>
        <Object class="Key Group Member" id="KGM020101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0201"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0201" name="IDX_academies_lat_lng">
        <Props><P n="Physical_Name">IDX_academies_lat_lng</P><P n="Index_Type">Non-Unique</P><P n="Comment">Composite index for geospatial proximity queries</P></Props>
        <Object class="Index Member" id="IDXM020101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0206"/></Props></Object>
        <Object class="Index Member" id="IDXM020102"><Props><P n="Sequence">1</P><P n="Index_Member_Column" ref="A0207"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0202" name="IDX_academies_city">
        <Props><P n="Physical_Name">IDX_academies_city</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM020201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0205"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0203" name="IDX_academies_rating">
        <Props><P n="Physical_Name">IDX_academies_rating</P><P n="Index_Type">Non-Unique</P><P n="Comment">Supports filtering and sorting by star rating</P></Props>
        <Object class="Index Member" id="IDXM020301"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0208"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: academy_photos
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E003" name="Academy Photos">
      <Props>
        <P n="Physical_Name">academy_photos</P>
        <P n="Schema">public</P>
        <P n="Comment">Photo gallery for each academy. One photo may be marked as primary (cover image).</P>
      </Props>

      <Object class="Attribute" id="A0301" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0302" name="academy_id">
        <Props><P n="Physical_Name">academy_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → academies.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A0303" name="url">
        <Props><P n="Physical_Name">url</P><P n="Datatype">TEXT</P><P n="Null_Option">NOT NULL</P><P n="Comment">Full URL to image (CDN or direct)</P></Props>
      </Object>
      <Object class="Attribute" id="A0304" name="is_primary">
        <Props><P n="Physical_Name">is_primary</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">FALSE</P><P n="Comment">Only one photo should have is_primary=TRUE per academy</P></Props>
      </Object>
      <Object class="Attribute" id="A0305" name="alt_text">
        <Props><P n="Physical_Name">alt_text</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG0301" name="PK_academy_photos">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_academy_photos</P></Props>
        <Object class="Key Group Member" id="KGM030101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0301"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0301" name="IDX_academy_photos_academy_id">
        <Props><P n="Physical_Name">IDX_academy_photos_academy_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM030101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0302"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: coaches
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E004" name="Coaches">
      <Props>
        <P n="Physical_Name">coaches</P>
        <P n="Schema">public</P>
        <P n="Comment">Coaching staff associated with an academy. sport_tags and certifications stored as PostgreSQL TEXT arrays.</P>
      </Props>

      <Object class="Attribute" id="A0401" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0402" name="academy_id">
        <Props><P n="Physical_Name">academy_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → academies.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A0403" name="name">
        <Props><P n="Physical_Name">name</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0404" name="photo">
        <Props><P n="Physical_Name">photo</P><P n="Datatype">TEXT</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0405" name="sport_tags">
        <Props><P n="Physical_Name">sport_tags</P><P n="Datatype">TEXT[]</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'{}'</P><P n="Comment">Array of sport names the coach specialises in, e.g. {&quot;Cricket&quot;,&quot;Athletics&quot;}</P></Props>
      </Object>
      <Object class="Attribute" id="A0406" name="experience_years">
        <Props><P n="Physical_Name">experience_years</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0407" name="bio">
        <Props><P n="Physical_Name">bio</P><P n="Datatype">TEXT</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0408" name="certifications">
        <Props><P n="Physical_Name">certifications</P><P n="Datatype">TEXT[]</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'{}'</P><P n="Comment">Array of certification names/institutions</P></Props>
      </Object>
      <Object class="Attribute" id="A0409" name="is_active">
        <Props><P n="Physical_Name">is_active</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">TRUE</P></Props>
      </Object>

      <Object class="Key Group" id="KG0401" name="PK_coaches">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_coaches</P></Props>
        <Object class="Key Group Member" id="KGM040101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0401"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0401" name="IDX_coaches_academy_id">
        <Props><P n="Physical_Name">IDX_coaches_academy_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM040101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0402"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: sport_programs
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E005" name="Sport Programs">
      <Props>
        <P n="Physical_Name">sport_programs</P>
        <P n="Schema">public</P>
        <P n="Comment">Training programs offered by an academy for a specific sport and age group. Each program has one or more time slots.</P>
      </Props>

      <Object class="Attribute" id="A0501" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0502" name="academy_id">
        <Props><P n="Physical_Name">academy_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → academies.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A0503" name="sport_type">
        <Props><P n="Physical_Name">sport_type</P><P n="Datatype">VARCHAR(100)</P><P n="Null_Option">NOT NULL</P><P n="Comment">e.g. Cricket, Football, Tennis, Badminton, Swimming</P></Props>
      </Object>
      <Object class="Attribute" id="A0504" name="name">
        <Props><P n="Physical_Name">name</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NOT NULL</P><P n="Comment">e.g. "Junior Cricket Coaching", "Advanced Football Training"</P></Props>
      </Object>
      <Object class="Attribute" id="A0505" name="description">
        <Props><P n="Physical_Name">description</P><P n="Datatype">TEXT</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0506" name="age_group_min">
        <Props><P n="Physical_Name">age_group_min</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">5</P></Props>
      </Object>
      <Object class="Attribute" id="A0507" name="age_group_max">
        <Props><P n="Physical_Name">age_group_max</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">60</P></Props>
      </Object>
      <Object class="Attribute" id="A0508" name="fee_monthly">
        <Props><P n="Physical_Name">fee_monthly</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Comment">Monthly training fee in INR (Indian Rupees)</P></Props>
      </Object>
      <Object class="Attribute" id="A0509" name="duration_months">
        <Props><P n="Physical_Name">duration_months</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">1</P><P n="Comment">Default enrollment duration. Can be overridden at enrollment time (1/3/6/12).</P></Props>
      </Object>
      <Object class="Attribute" id="A0510" name="is_active">
        <Props><P n="Physical_Name">is_active</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">TRUE</P></Props>
      </Object>
      <Object class="Attribute" id="A0511" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>

      <Object class="Key Group" id="KG0501" name="PK_sport_programs">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_sport_programs</P></Props>
        <Object class="Key Group Member" id="KGM050101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0501"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0501" name="IDX_sport_programs_academy_id">
        <Props><P n="Physical_Name">IDX_sport_programs_academy_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM050101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0502"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0502" name="IDX_sport_programs_sport_type">
        <Props><P n="Physical_Name">IDX_sport_programs_sport_type</P><P n="Index_Type">Non-Unique</P><P n="Comment">Supports filtering programs by sport</P></Props>
        <Object class="Index Member" id="IDXM050201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0503"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: slots
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E006" name="Slots">
      <Props>
        <P n="Physical_Name">slots</P>
        <P n="Schema">public</P>
        <P n="Comment">Time slots for a sport program. enrolled_count is incremented/decremented transactionally during enrollment/cancellation to prevent over-booking.</P>
      </Props>

      <Object class="Attribute" id="A0601" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0602" name="program_id">
        <Props><P n="Physical_Name">program_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → sport_programs.id  CASCADE DELETE</P></Props>
      </Object>
      <Object class="Attribute" id="A0603" name="time_start">
        <Props><P n="Physical_Name">time_start</P><P n="Datatype">VARCHAR(10)</P><P n="Null_Option">NOT NULL</P><P n="Comment">24h time string, e.g. "06:00". Stored as VARCHAR to avoid timezone issues.</P></Props>
      </Object>
      <Object class="Attribute" id="A0604" name="time_end">
        <Props><P n="Physical_Name">time_end</P><P n="Datatype">VARCHAR(10)</P><P n="Null_Option">NOT NULL</P><P n="Comment">24h time string, e.g. "07:30"</P></Props>
      </Object>
      <Object class="Attribute" id="A0605" name="days_of_week">
        <Props><P n="Physical_Name">days_of_week</P><P n="Datatype">TEXT[]</P><P n="Null_Option">NOT NULL</P><P n="Comment">e.g. {&quot;MONDAY&quot;,&quot;WEDNESDAY&quot;,&quot;FRIDAY&quot;}. Used for transport fee calculation (Mon-Sat only).</P></Props>
      </Object>
      <Object class="Attribute" id="A0606" name="total_capacity">
        <Props><P n="Physical_Name">total_capacity</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Comment">Maximum number of concurrent enrollments</P></Props>
      </Object>
      <Object class="Attribute" id="A0607" name="enrolled_count">
        <Props><P n="Physical_Name">enrolled_count</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">0</P><P n="Comment">Current active enrollments. Managed via prisma.$transaction to prevent race conditions.</P></Props>
      </Object>
      <Object class="Attribute" id="A0608" name="transport_capacity">
        <Props><P n="Physical_Name">transport_capacity</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">20</P><P n="Comment">Maximum students that can use transport for this slot</P></Props>
      </Object>
      <Object class="Attribute" id="A0609" name="is_active">
        <Props><P n="Physical_Name">is_active</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">TRUE</P></Props>
      </Object>

      <Object class="Key Group" id="KG0601" name="PK_slots">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_slots</P></Props>
        <Object class="Key Group Member" id="KGM060101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0601"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0601" name="IDX_slots_program_id">
        <Props><P n="Physical_Name">IDX_slots_program_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM060101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0602"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: enrollments
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E007" name="Enrollments">
      <Props>
        <P n="Physical_Name">enrollments</P>
        <P n="Schema">public</P>
        <P n="Comment">Core booking record linking a user to a slot. Unique constraint on (user_id, slot_id) prevents duplicate enrollments. Pickup coords stored here to snapshot the address at time of enrollment.</P>
      </Props>

      <Object class="Attribute" id="A0701" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0702" name="user_id">
        <Props><P n="Physical_Name">user_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → users.id</P></Props>
      </Object>
      <Object class="Attribute" id="A0703" name="slot_id">
        <Props><P n="Physical_Name">slot_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → slots.id</P></Props>
      </Object>
      <Object class="Attribute" id="A0704" name="transport_opted">
        <Props><P n="Physical_Name">transport_opted</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">FALSE</P><P n="Comment">Whether user opted for pickup/drop service. Triggers transport_fee in payment.</P></Props>
      </Object>
      <Object class="Attribute" id="A0705" name="pickup_lat">
        <Props><P n="Physical_Name">pickup_lat</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NULL</P><P n="Comment">User's pickup latitude (set when transport_opted=TRUE)</P></Props>
      </Object>
      <Object class="Attribute" id="A0706" name="pickup_lng">
        <Props><P n="Physical_Name">pickup_lng</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0707" name="pickup_address">
        <Props><P n="Physical_Name">pickup_address</P><P n="Datatype">TEXT</P><P n="Null_Option">NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0708" name="pickup_distance">
        <Props><P n="Physical_Name">pickup_distance</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NULL</P><P n="Comment">Distance in km from pickup point to academy (Haversine). Used to calculate transport fee at ₹25/km/day.</P></Props>
      </Object>
      <Object class="Attribute" id="A0709" name="duration_months">
        <Props><P n="Physical_Name">duration_months</P><P n="Datatype">INTEGER</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">1</P><P n="Comment">Chosen enrollment duration: 1, 3, 6, or 12 months</P></Props>
      </Object>
      <Object class="Attribute" id="A0710" name="start_date">
        <Props><P n="Physical_Name">start_date</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NULL</P><P n="Comment">User-chosen start date (Mon–Sat, can be same-day if before slot time)</P></Props>
      </Object>
      <Object class="Attribute" id="A0711" name="end_date">
        <Props><P n="Physical_Name">end_date</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NULL</P><P n="Comment">Computed: start_date + duration_months</P></Props>
      </Object>
      <Object class="Attribute" id="A0712" name="status">
        <Props><P n="Physical_Name">status</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'PENDING'</P><P n="Domain_Ref">D002</P><P n="Comment">See EnrollmentStatus domain</P></Props>
      </Object>
      <Object class="Attribute" id="A0713" name="enrolled_at">
        <Props><P n="Physical_Name">enrolled_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>
      <Object class="Attribute" id="A0714" name="expires_at">
        <Props><P n="Physical_Name">expires_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NULL</P><P n="Comment">When the enrollment term expires (triggers EXPIRED status)</P></Props>
      </Object>
      <Object class="Attribute" id="A0715" name="updated_at">
        <Props><P n="Physical_Name">updated_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG0701" name="PK_enrollments">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_enrollments</P></Props>
        <Object class="Key Group Member" id="KGM070101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0701"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG0702" name="UQ_enrollments_user_slot">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_enrollments_user_slot</P><P n="Comment">Prevents duplicate enrollment for same user+slot combination</P></Props>
        <Object class="Key Group Member" id="KGM070201"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0702"/></Props></Object>
        <Object class="Key Group Member" id="KGM070202"><Props><P n="Sequence">1</P><P n="Key_Group_Member_Column" ref="A0703"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0701" name="IDX_enrollments_user_id">
        <Props><P n="Physical_Name">IDX_enrollments_user_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM070101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0702"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0702" name="IDX_enrollments_slot_id">
        <Props><P n="Physical_Name">IDX_enrollments_slot_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM070201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0703"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0703" name="IDX_enrollments_status">
        <Props><P n="Physical_Name">IDX_enrollments_status</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM070301"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0712"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: payments
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E008" name="Payments">
      <Props>
        <P n="Physical_Name">payments</P>
        <P n="Schema">public</P>
        <P n="Comment">Payment record per enrollment. One-to-one with enrollments. Gateway = Razorpay. webhook_verified=TRUE when server-side HMAC verification succeeds.</P>
      </Props>

      <Object class="Attribute" id="A0801" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0802" name="user_id">
        <Props><P n="Physical_Name">user_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → users.id  (denormalised for faster user payment queries)</P></Props>
      </Object>
      <Object class="Attribute" id="A0803" name="enrollment_id">
        <Props><P n="Physical_Name">enrollment_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → enrollments.id  UNIQUE (1:1)</P></Props>
      </Object>
      <Object class="Attribute" id="A0804" name="amount">
        <Props><P n="Physical_Name">amount</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Comment">Training fee in INR. Prorated if start_date is mid-month.</P></Props>
      </Object>
      <Object class="Attribute" id="A0805" name="transport_fee">
        <Props><P n="Physical_Name">transport_fee</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">0</P><P n="Comment">Transport fee = pickup_distance × ₹25/km × working_days_per_month (Mon–Sat = 26)</P></Props>
      </Object>
      <Object class="Attribute" id="A0806" name="total_amount">
        <Props><P n="Physical_Name">total_amount</P><P n="Datatype">FLOAT8</P><P n="Null_Option">NOT NULL</P><P n="Comment">amount + transport_fee. Charged to Razorpay order in paise (×100).</P></Props>
      </Object>
      <Object class="Attribute" id="A0807" name="currency">
        <Props><P n="Physical_Name">currency</P><P n="Datatype">VARCHAR(10)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'INR'</P></Props>
      </Object>
      <Object class="Attribute" id="A0808" name="gateway">
        <Props><P n="Physical_Name">gateway</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'razorpay'</P></Props>
      </Object>
      <Object class="Attribute" id="A0809" name="gateway_order_id">
        <Props><P n="Physical_Name">gateway_order_id</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NULL</P><P n="Comment">Razorpay order_id (e.g. order_XXXXX). UNIQUE.</P></Props>
      </Object>
      <Object class="Attribute" id="A0810" name="gateway_txn_id">
        <Props><P n="Physical_Name">gateway_txn_id</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NULL</P><P n="Comment">Razorpay payment_id from webhook/confirm. UNIQUE.</P></Props>
      </Object>
      <Object class="Attribute" id="A0811" name="status">
        <Props><P n="Physical_Name">status</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'PENDING'</P><P n="Domain_Ref">D003</P></Props>
      </Object>
      <Object class="Attribute" id="A0812" name="webhook_verified">
        <Props><P n="Physical_Name">webhook_verified</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">FALSE</P><P n="Comment">TRUE only when Razorpay webhook HMAC-SHA256 signature verified server-side</P></Props>
      </Object>
      <Object class="Attribute" id="A0813" name="created_at">
        <Props><P n="Physical_Name">created_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">NOW()</P></Props>
      </Object>
      <Object class="Attribute" id="A0814" name="updated_at">
        <Props><P n="Physical_Name">updated_at</P><P n="Datatype">TIMESTAMPTZ</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>

      <Object class="Key Group" id="KG0801" name="PK_payments">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_payments</P></Props>
        <Object class="Key Group Member" id="KGM080101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0801"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG0802" name="UQ_payments_enrollment_id">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_payments_enrollment_id</P><P n="Comment">Enforces 1:1 between payment and enrollment</P></Props>
        <Object class="Key Group Member" id="KGM080201"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0803"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG0803" name="UQ_payments_gateway_order_id">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_payments_gateway_order_id</P></Props>
        <Object class="Key Group Member" id="KGM080301"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0809"/></Props></Object>
      </Object>
      <Object class="Key Group" id="KG0804" name="UQ_payments_gateway_txn_id">
        <Props><P n="Key_Group_Type">Unique</P><P n="Physical_Name">UQ_payments_gateway_txn_id</P></Props>
        <Object class="Key Group Member" id="KGM080401"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0810"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0801" name="IDX_payments_user_id">
        <Props><P n="Physical_Name">IDX_payments_user_id</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM080101"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0802"/></Props></Object>
      </Object>
      <Object class="Index" id="IDX0802" name="IDX_payments_status">
        <Props><P n="Physical_Name">IDX_payments_status</P><P n="Index_Type">Non-Unique</P></Props>
        <Object class="Index Member" id="IDXM080201"><Props><P n="Sequence">0</P><P n="Index_Member_Column" ref="A0811"/></Props></Object>
      </Object>
    </Object>

    <!-- ═══════════════════════════════════════════════════════════
         ENTITY: transport_routes
         ═══════════════════════════════════════════════════════════ -->

    <Object class="Entity" id="E009" name="Transport Routes">
      <Props>
        <P n="Physical_Name">transport_routes</P>
        <P n="Schema">public</P>
        <P n="Comment">Vehicle and driver configuration per academy. Used to populate driver details in daily transit sessions.</P>
      </Props>

      <Object class="Attribute" id="A0901" name="id">
        <Props><P n="Physical_Name">id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">cuid()</P></Props>
      </Object>
      <Object class="Attribute" id="A0902" name="academy_id">
        <Props><P n="Physical_Name">academy_id</P><P n="Datatype">VARCHAR(30)</P><P n="Null_Option">NOT NULL</P><P n="Comment">FK → academies.id</P></Props>
      </Object>
      <Object class="Attribute" id="A0903" name="vehicle_id">
        <Props><P n="Physical_Name">vehicle_id</P><P n="Datatype">VARCHAR(100)</P><P n="Null_Option">NOT NULL</P><P n="Comment">Internal vehicle identifier</P></Props>
      </Object>
      <Object class="Attribute" id="A0904" name="driver_id">
        <Props><P n="Physical_Name">driver_id</P><P n="Datatype">VARCHAR(100)</P><P n="Null_Option">NOT NULL</P><P n="Comment">Internal driver identifier (not FK — driver may not have a user account)</P></Props>
      </Object>
      <Object class="Attribute" id="A0905" name="driver_name">
        <Props><P n="Physical_Name">driver_name</P><P n="Datatype">VARCHAR(255)</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0906" name="driver_phone">
        <Props><P n="Physical_Name">driver_phone</P><P n="Datatype">VARCHAR(20)</P><P n="Null_Option">NOT NULL</P></Props>
      </Object>
      <Object class="Attribute" id="A0907" name="vehicle_number">
        <Props><P n="Physical_Name">vehicle_number</P><P n="Datatype">VARCHAR(20)</P><P n="Null_Option">NOT NULL</P><P n="Comment">License plate number, e.g. TS09AB1234</P></Props>
      </Object>
      <Object class="Attribute" id="A0908" name="vehicle_type">
        <Props><P n="Physical_Name">vehicle_type</P><P n="Datatype">VARCHAR(50)</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">'Van'</P><P n="Comment">e.g. Van, Bus, Auto</P></Props>
      </Object>
      <Object class="Attribute" id="A0909" name="is_active">
        <Props><P n="Physical_Name">is_active</P><P n="Datatype">BOOLEAN</P><P n="Null_Option">NOT NULL</P><P n="Default_Value">TRUE</P></Props>
      </Object>

      <Object class="Key Group" id="KG0901" name="PK_transport_routes">
        <Props><P n="Key_Group_Type">PrimaryKey</P><P n="Physical_Name">PK_transport_routes</P></Props>
        <Object class="Key Group Member" id="KGM090101"><Props><P n="Sequence">0</P><P n="Key_Group_Member_Column" ref="A0901"/></Props></Object>
      </Object>

      <Object class="Index" id="IDX0901" name="IDX_transport_routes_academy_id">
        <Props><P n="Physical_Name">IDX_transport_routes_academy_id</P><P n="Index_Type">Non-Unique</P></Props>
