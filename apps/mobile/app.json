{
  "expo": {
    "name": "SportNexus",
    "slug": "sportnexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "scheme": "sportshub",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sportnexus.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D9488"
      },
      "package": "com.sportnexus.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBBX9JgBTmpZV3ftmWMGl6hcenP2VW0zzo"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5905a25-92ec-40bf-92ef-8c43564390f2"
      }
    },
    "owner": "teja016"
  }
}
